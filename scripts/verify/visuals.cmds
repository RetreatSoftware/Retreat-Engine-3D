# Looks driven by game code: a color per entity, a character as a plain shape with its facing or as
# an animated model, and smooth drawing. All render only: the state hash does not change.
physics.spawn_character one -2.5 0.9 2.5 0.5 0.4
physics.spawn_character two 0 0.9 2.5 0.5 0.4
physics.spawn_character three 2.5 0.9 2.5 0.5 0.4
wait 2
visual.set_character one shape 1 0 0
visual.set_color one 0.9 0.2 0.2
visual.set_character two shape 1 0 1.5708
visual.set_color two 0.2 0.8 0.3
visual.set_character three models/Fox.glb 0.015 -0.9 0
wait_until 600 assert.visual_ready three
wait 5
assert.visual_ready one
snapshot visuals_shapes_and_model
visual.set_color three 0.3 0.5 1
visual.set_character three models/Fox.glb 0.015 -0.9 -1.5708
visual.play three Run 1
visual.set_character one models/Fox.glb 0.015 -0.9 3.1416
wait_until 600 assert.visual_ready one
wait 20
assert.animation_playing three/visual Run
snapshot visuals_turned_and_running
# Smooth drawing follows the simulation one tick behind and settles on it.
render.smooth two 0.05 2
wait 5
assert.drawn_position two 0 0.9 2.5 0.01
physics.teleport two 0 0.9 -2
wait 5
assert.drawn_position two 0 0.9 -2 0.01
snapshot visuals_end
quit
