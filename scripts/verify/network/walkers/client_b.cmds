# Walkers check, client B: spawns its character, walks it east with the analog axis, turns with the
# mouse and jumps. Every input travels as a command line per tick and is predicted.
wait_until 3000 assert.net_joined
net.send sandbox.walker_spawn -4 -2.8
wait 40
input.set_axis walk_x 1
# A browser that stalls sends its inputs late and the server runs several on one tick, so a short
# hold sometimes moved less than the 1 unit the check needs. A much longer one walks off the ground
# (x 5; 80 ticks fell in CI): 60 ticks end near x 0.6 at the most.
wait 60
input.look -40 0
wait 10
input.key_down Space
wait 4
input.key_up Space
input.clear_axis walk_x
wait_until 20000 assert.entity_exists walker_0
wait_until 20000 assert.entity_exists walker_1
# Client A fires a rocket: it explodes once here too.
wait_until 20000 assert.effects_played 1
wait 500
assert.effects_played 1
# Its sound too: once, whatever was predicted, replayed or corrected.
assert.audio_events 1
assert.walker_rockets 0
net.bodies
net.states
net.stats
# Budgets: an input line every tick (measured well under half of these).
assert.net_bytes_below sent 400000
assert.net_bytes_below received 400000
assert.net_corrections_at_most 400
# Stay connected while the others print.
wait 600
quit
